DB_URL=jdbc:postgresql://localhost:5432/farmlink
DB_USERNAME=postgres
DB_PASSWORD=your_postgres_password

# Where the React app runs (used to build the password reset link)
FRONTEND_URL=http://localhost:5173

# Optional: send real reset emails (e.g. Gmail with an App Password). Leave these lines out
# to run in development mode, where the reset link is printed in the backend console instead.
# spring.mail.host=smtp.gmail.com
# spring.mail.username=your_address@gmail.com
# spring.mail.password=your_gmail_app_password
# MAIL_FROM=your_address@gmail.com
